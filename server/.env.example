# Copy to .env and fill in. Any value left blank or starting with "your_" is
# treated as unset, and that subsystem falls back to local mode.

PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# Supabase — Project Settings > API. The service role key is server-only.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay — Dashboard > Settings > API Keys. Use test keys while developing.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Super-admin login for /admin. Seeded on server boot — set both before
# deploying anywhere public. Left unset, the server falls back to
# admin@everafter.com / ChangeMe123! and prints a warning on startup.
ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password

# Where uploaded member photos are written, relative to /server.
UPLOADS_DIR=uploads

# Outgoing mail for parent confirmation emails. Leave SMTP_HOST blank in
# development — emails are printed to the API console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EverAfter <no-reply@everafter.com>
