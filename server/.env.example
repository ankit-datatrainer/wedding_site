# Copy to .env and fill in. Any value left blank or starting with "your_" is
# treated as unset, and that subsystem falls back to local mode.

PORT=4000
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# Supabase — Project Settings > API. The service role key is server-only.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay — Dashboard > Settings > API Keys. Use test keys while developing.
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
